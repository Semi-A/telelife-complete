SERVICE=telelife
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=false

# Paste the Supabase transaction-pooler URL (normally port 6543) and require TLS.
DATABASE_URL=
DB_POOL_MIN=1
DB_POOL_MAX=5
DB_COMMAND_TIMEOUT=15
DB_STATEMENT_CACHE_SIZE=0

TELELIFE_BOT_TOKEN=
TELEWORLD_BOT_TOKEN=
GLOBAL_NEWS_CHAT_ID=

RUN_MODE=polling
WEBHOOK_BASE_URL=
WEBHOOK_SECRET=
PORT=8000
HOST=0.0.0.0

ADMIN_USERNAME=
ADMIN_PASSWORD=
